# Copy this file to .env and fill in your values. Never commit .env.

# AMD Token Factory (OpenAI-compatible API served on AMD GPUs)
# Base URL and model names: confirm in the Token Factory user manual / model catalogue.
AMD_API_BASE_URL=
AMD_API_KEY=

# Model that reads images (handwritten prescriptions, invoices, orders)
AMD_VISION_MODEL=
# Model that reasons over the case (audits, answers questions)
AMD_TEXT_MODEL=
